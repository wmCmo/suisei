# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Project Settings -> Data API gives you the first two.

SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key is designed to be public. It ships inside the built page,
# where anyone can read it, and row level security is what actually decides
# who may read or write what. Keeping it out of the repo is tidiness, not
# protection -- the protection is in supabase/schema.sql.
SUPABASE_ANON_KEY=

# The database password, for psql and the Supabase CLI. This one is a real
# secret: it never reaches the browser and must never be inlined by the build.
DB_PW=

# Deliberately absent: the service_role key. It bypasses row level security
# completely, so it has no business in a repo whose build inlines values into
# a static page. If a server ever needs it, it belongs in that server's own
# environment and nowhere near this file.
